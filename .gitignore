# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-wheel-metadata/

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.python-version

# ─── Environment & Secrets (NEVER commit API keys or encryption keys) ────────
.env
*.env
.env.local
.env.*.local
secrets.yaml
secrets.json

# ─── SQLite Database ─────────────────────────────────────────────────────────
# notes.db contains AES-256 encrypted private user notes.
# It must NEVER be committed to Git.
# On first run the app creates it automatically.
# On subsequent runs the app connects to it and loads all existing data.
notes.db
notes.db-shm
notes.db-wal
*.db
*.sqlite3

# ─── Audio Uploads (user files, can be large) ────────────────────────────────
# The uploads/ folder skeleton is kept via .gitkeep — only audio files are ignored.
uploads/*
!uploads/.gitkeep
*.mp3
*.wav
*.m4a
*.ogg
*.webm
*.flac
*.opus
*.aac

# ─── AI Model Weights (heavy files — download separately via HuggingFace) ────
*.gguf
*.ggml
*.bin
*.pt
*.ckpt
*.safetensors
*.pth
models/
model_cache/
.cache/huggingface/
huggingface/

# ─── Whisper & llama-cpp caches ──────────────────────────────────────────────
whisper_cache/
faster_whisper_cache/
llama_cache/
~/.cache/huggingface/

# ─── Jupyter Notebook Checkpoints ────────────────────────────────────────────
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/
*.ipynb_checkpoints

