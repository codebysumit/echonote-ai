# Smart Audio Notes — 100% Local CPU Configuration
# No API keys required! Runs completely offline on laptop CPU.

# Local Whisper Model Size ('tiny', 'base', 'small') - 'base' is recommended for laptops
WHISPER_MODEL_SIZE=base

# Number of CPU threads to utilize for inference (e.g. 2, 4)
CPU_THREADS=2

# Gemma GGUF Model identifier for llama-cpp-python
GGUF_REPO_ID=unsloth/gemma-3-1b-it-GGUF
GGUF_FILENAME=gemma-3-1b-it-Q4_K_M.gguf

# Master AES Encryption Passphrase for SQLite
MASTER_ENCRYPTION_KEY=SmartAudioNotes_SecureKey_2026_DevWeek

# Server Port
PORT=8000
